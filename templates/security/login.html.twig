{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('login') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('login') }}
{% endblock %}

{% block body %}

    <form class="form-signin needs-validation" method="post" novalidate>
        {% if app.user %}
            <div class="alert alert-primary">
                You are already logged in as {{ app.user.username }}, <a href="{{ path('app_logout') }}">Logout</a>
            </div>
        {% endif %}
        {% if error %}
            <div class="alert alert-danger" role="alert">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}
        <label for="inputUsername" class="sr-only">User Name</label>
        <input value="{{ last_username }}" name="username" type="text" id="inputUsername" class="form-control"
               placeholder="User Name" required autofocus>
        <div class="invalid-feedback">
            Please provide a user name.
        </div>
        <label for="inputPassword" class="sr-only">Password</label>
        <input type="password" name="password" id="inputPassword" class="form-control" placeholder="Password" required>
        <div class="invalid-feedback">
            Please provide a password.
        </div>
        <button class="btn btn-lg btn-primary btn-block" type="submit">Login</button>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    </form>

{% endblock %}
